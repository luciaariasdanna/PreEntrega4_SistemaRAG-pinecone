# Copiá este archivo a .env y completá los valores. El .env NO se sube al repo.

# Obligatoria: https://app.pinecone.io -> API Keys
PINECONE_API_KEY=
# Nombre del índice Serverless (se crea solo si no existe)
INDEX_NAME=fastapi-docs-rag

# Proveedor de embeddings: google (por defecto, 768 dims) | huggingface (local, 384) | openai (1536)
EMBEDDING_PROVIDER=google
# Obligatoria con google. Gratis en https://aistudio.google.com/apikey (también sirve GEMINI_API_KEY)
GOOGLE_API_KEY=
# Solo si EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Opcionales
PINECONE_NAMESPACE=fastapi-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Peso del BM25 en el EnsembleRetriever (el vectorial recibe 1 - PESO_BM25)
PESO_BM25=0.5
